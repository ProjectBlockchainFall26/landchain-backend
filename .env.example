# Copy to .env and fill in. NEVER commit .env. Values for Supabase and signer keys are shared privately (task A1).
# Spec section 14 lists every variable.

# ---- Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api

# ---- Database
# Local postgis container (docker compose):
DATABASE_URL=postgres://landchain:landchain@localhost:5432/landchain
# Supabase session pooler (task A1). Switch the scheme to postgis:// after task C2 adds GeoDjango.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SCHEMA=landchain

# ---- Supabase (A1 / A2 / D2)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_DOCS_BUCKET=parcel-documents
# Local-only login with header X-Dev-User: <email> (task A2). Never true in production.
DEV_AUTH=true

# ---- Redis / Celery (B1)
REDIS_URL=redis://localhost:6379/0
# Local demo without workers: run signer/relay tasks inline and let ?wait=true run the indexer itself.
# Leave false when the worker, signer and beat services run (docker compose --profile workers up).
CELERY_TASK_ALWAYS_EAGER=false
INDEXER_INLINE=false

# ---- Chain (B2 / B4). Ganache from landchain-contracts: `npm run chain`, port 7545.
CHAIN_ID=1337
RPC_URL=http://host.docker.internal:7545
RPC_URL_PUBLIC=http://127.0.0.1:7545
CONTRACTS_DIR=./contracts
CHAIN_CONFIRMATIONS=0
REGISTRAR_SIGNER_KEY=
ID_OFFICER_SIGNER_KEY=
ADMIN_SIGNER_KEY=
# Local only: with no *_SIGNER_KEY set, officer actions are sent from Ganache's unlocked role accounts.
CHAIN_ALLOW_UNLOCKED_SIGNING=true
# Optional overrides of contracts/deployments.local.json (e.g. Sepolia):
# LAND_ACCESS_CONTROL_ADDRESS= IDENTITY_REGISTRY_ADDRESS= TITLE_REGISTRY_ADDRESS= FEE_LEDGER_ADDRESS= START_BLOCK=

# ---- Demo (A6)
DEMO_MODE=true
DEMO_PASSWORD=landchain-demo

# ---- Frontend / SIWE (A4)
CORS_ALLOWED_ORIGINS=http://localhost:5173
SITE_DOMAIN=localhost:5173
SITE_URI=http://localhost:5173

# ---- Documents (D2): without Supabase keys, files are kept here (development only)
VAULT_LOCAL_DIR=./var/vault

# ---- Relay (A7) and anti-abuse (A8)
DEFAULT_FROM_EMAIL=LandChain <no-reply@landchain.local>
# SMS_PROVIDER: empty (log only) | twilio (SMS_API_KEY=sid:token) | hubtel (SMS_API_KEY=clientid:secret)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
CAPTCHA_SECRET=
ENQUIRY_IP_SALT=change-me
REQUIRE_OFFICER_MFA=false

# ---- Caddy (production only)
API_DOMAIN=localhost
